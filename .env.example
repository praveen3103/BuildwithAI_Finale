# Google AI Studio API Key (Required for local Gemini agent execution)
# Get a key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your-gemini-api-key-here

# Target Google Cloud Configuration (Required for Cloud Run deployment and Vertex AI integration)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here
GOOGLE_CLOUD_REGION=us-central1

# Application URLs (Defaults are set automatically, modify only if routing changes)
BACKEND_URL=http://localhost:8000
PORT=8080
